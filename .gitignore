/fdl/
.idea
.DS_Store
**/__pycache__/
*.node
**/tests/outputs/
site/**

# C++ build artifacts
native/core/build/
native/core/cmake-build-*/
native/build/

# Doxygen generated docs
native/core/docs/api/

# TypeDoc generated docs
docs/node-api/

# Python build artifacts
native/bindings/python/build/**
native/bindings/python/fdl.egg-info/**

# Viewer build artifacts
packages/fdl_viewer/.build_venv/**
packages/fdl_viewer/build/**
packages/fdl_viewer/dist/**
/build/*

# Node.js / TypeScript build artifacts
**/node_modules/
native/bindings/node/build/
native/bindings/node/dist/

# WASM / Emscripten build artifacts
# - bindings/wasm/build/   : CMake build dir (object files, static libs, etc.)
# - bindings/wasm/cmake-build-* : IDE-flavoured build dirs
# - bindings/node/wasm/*.{mjs,wasm,wasm.map} : compiled artifacts copied here by
#   scripts/build_wasm.py and downloaded by the npm_publish CI job.
native/bindings/wasm/build/
native/bindings/wasm/cmake-build-*/
native/bindings/node/wasm/*.mjs
native/bindings/node/wasm/*.wasm
native/bindings/node/wasm/*.wasm.map

# Local emsdk install (some devs put it inside the repo root)
/emsdk/

# Example app build artifacts
examples/**/dist/
examples/**/.vite/
